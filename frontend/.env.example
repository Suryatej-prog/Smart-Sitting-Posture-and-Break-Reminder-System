# Copy to .env and adjust.
# Where the backend runs (Express + Socket.IO share this address).
VITE_API_URL=http://localhost:5000
# Optional: lock the dashboard to one device (leave empty to auto-pick).
VITE_DEVICE_ID=
# Seconds without a sensor message before the device is shown as disconnected.
# Set this to a bit more than 2x the ESP32 publish interval.
VITE_STALE_SECONDS=8
