# Server
PORT=5000
CORS_ORIGIN=*

# MongoDB
MONGODB_URI=mongodb://localhost:27017/smartchair

# MQTT broker (agree the final address with the ESP32 developer)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=smartchair-backend
MQTT_USERNAME=
MQTT_PASSWORD=

# MQTT topics. '+' is a single-level wildcard for the device id.
MQTT_SENSOR_TOPIC=smartchair/+/sensors
MQTT_CALIBRATION_TOPIC=smartchair/+/calibration
# Topic pattern the backend publishes device commands to ({deviceId} is replaced)
MQTT_COMMAND_TOPIC_PATTERN=smartchair/{deviceId}/commands

# Break reminder threshold in seconds (60 for the demo)
BREAK_THRESHOLD_SECONDS=60
